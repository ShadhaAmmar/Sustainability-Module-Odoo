<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_carbon_alternative_wizard_form" model="ir.ui.view">
        <field name="name">carbon.alternative.wizard.form</field>
        <field name="model">carbon.alternative.wizard</field>
        <field name="arch" type="xml">
            <form string="Alternatives écologiques">
                <group>
                    <field name="product_id"/>
                    <field name="current_intensity"/>
                    <field name="purchase_line_id" invisible="1"/>
                </group>
                <div class="alert alert-warning" role="alert" invisible="line_ids">
                    Aucune alternative plus sobre en carbone n'a été trouvée. Renseignez l'intensité carbone
                    de vos produits (onglet « Durabilité ») ou déclarez des alternatives sur la fiche produit.
                </div>
                <field name="line_ids" nolabel="1">
                    <tree create="0" delete="0" edit="0">
                        <field name="product_id"/>
                        <field name="carbon_intensity"/>
                        <field name="reduction_pct"/>
                        <field name="declared" optional="hide"/>
                        <field name="supplier_id"/>
                        <field name="supplier_esg_score"/>
                        <field name="standard_price"/>
                        <button name="action_replace" type="object" icon="fa-exchange" string="Remplacer"
                                invisible="not parent.purchase_line_id"/>
                    </tree>
                </field>
                <footer>
                    <button string="Fermer" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
