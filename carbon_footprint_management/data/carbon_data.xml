<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_carbon_footprint" model="ir.sequence">
            <field name="name">Empreinte carbone</field>
            <field name="code">carbon.footprint</field>
            <field name="prefix">CF/%(year)s/</field>
            <field name="padding">5</field>
        </record>
        <record id="seq_carbon_certificate" model="ir.sequence">
            <field name="name">Certificat carbone</field>
            <field name="code">carbon.certificate</field>
            <field name="prefix">CERT/%(year)s/</field>
            <field name="padding">5</field>
        </record>
        <record id="seq_esg_scoring" model="ir.sequence">
            <field name="name">Évaluation ESG</field>
            <field name="code">esg.scoring</field>
            <field name="prefix">ESG/%(year)s/</field>
            <field name="padding">5</field>
        </record>

        <record id="carbon_factor_default" model="carbon.factor">
            <field name="name">Facteurs par défaut (valeurs indicatives)</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="reference">Ordres de grandeur ADEME / DEFRA / AIE : à remplacer par vos sources officielles</field>
        </record>

        <record id="config_esg_min_score" model="ir.config_parameter">
            <field name="key">carbon_footprint_management.esg_min_score</field>
            <field name="value">50</field>
        </record>
    </data>
</odoo>
