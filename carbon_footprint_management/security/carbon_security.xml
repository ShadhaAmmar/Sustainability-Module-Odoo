<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_carbon" model="ir.module.category">
            <field name="name">Durabilité &amp; Carbone</field>
            <field name="sequence">55</field>
        </record>

        <record id="group_carbon_user" model="res.groups">
            <field name="name">Utilisateur</field>
            <field name="category_id" ref="module_category_carbon"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_carbon_manager" model="res.groups">
            <field name="name">Responsable durabilité</field>
            <field name="category_id" ref="module_category_carbon"/>
            <field name="implied_ids" eval="[(4, ref('group_carbon_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="rule_carbon_footprint_company" model="ir.rule">
            <field name="name">Empreinte carbone : multi-sociétés</field>
            <field name="model_id" ref="model_carbon_footprint"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_carbon_certificate_company" model="ir.rule">
            <field name="name">Certificat carbone : multi-sociétés</field>
            <field name="model_id" ref="model_carbon_certificate"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_esg_scoring_company" model="ir.rule">
            <field name="name">Évaluation ESG : multi-sociétés</field>
            <field name="model_id" ref="model_esg_scoring"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_carbon_report_company" model="ir.rule">
            <field name="name">Rapport de durabilité : multi-sociétés</field>
            <field name="model_id" ref="model_carbon_report"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_carbon_factor_company" model="ir.rule">
            <field name="name">Facteurs d'émission : multi-sociétés</field>
            <field name="model_id" ref="model_carbon_factor"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
